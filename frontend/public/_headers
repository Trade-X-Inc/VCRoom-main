# NOTE: this list must stay in sync with SECURITY_HEADERS in
# scripts/patch-wrangler.mjs. This file only applies to paths excluded from
# the SSR worker in _routes.json (static assets); everything else is served
# by _worker.js, which _headers never reaches (see CLAUDE.md §44). Editing
# one list without the other silently diverges what's actually live between
# static and SSR-routed responses.
#
# Content-Security-Policy is DELIBERATELY ABSENT here, and that is not a
# drift from patch-wrangler.mjs (13 Sep 2026, CSP flipped to enforcing).
# Two reasons: (1) this file only covers static assets — JS/CSS/images/fonts
# — and a document-oriented CSP on a .js or .png response governs nothing;
# (2) the enforcing policy carries a PER-REQUEST nonce, which a static text
# file physically cannot express. Do not "fix" this by adding a CSP line
# here: a nonce-less policy would either be ignored (harmless but
# misleading) or, if it ever did apply to a document, would block the
# nonce-carrying inline bootstrap script and white-screen the site.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/app/*
  X-Robots-Tag: noindex, nofollow

# Immutable, hash-named build assets — long cache is safe since a content
# change always produces a new filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
